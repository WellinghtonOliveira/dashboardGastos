{
  "name": "control-gastos",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Painel de Controle - Gerenciar Gastos",
  "devDependencies": {
    "electron": "^40.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dashboardgastos.control",
    "productName": "Dashboard Gastos",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../dashboard",
        "to": "dashboard",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    }
  },
  "dependencies": {}
}
